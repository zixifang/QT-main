+def _read_index(out_dir: Path) -> dict:
+    path = out_dir / "index.json"
+    if not path.exists():
+        return {}
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def _index_series(data_dir: Path, symbol: str) -> pd.Series:
+    """读指数行情（例如 data/nasdaq100/NDX.csv），按日期升序返回收盘价。"""
+    path = data_dir / f"{symbol}.csv"
+    if not path.exists():
+        raise FileNotFoundError(f"缺少指数行情：{path}")
+    frame = pd.read_csv(path)
+    frame = frame.rename(columns={name: name.strip().lower() for name in frame.columns})
+    if "date" not in frame.columns or "close" not in frame.columns:
+        raise ValueError(f"{path} 需要 date、close 两列")
+    table = frame.loc[:, ["date", "close"]].copy()
+    table["date"] = pd.to_datetime(table["date"])
+    table["close"] = pd.to_numeric(table["close"], errors="coerce")
+    table = table.dropna().sort_values("date")
+    return table.set_index("date")["close"].astype("float64")
+
+
+def build_index_entry(
+    algorithm: dict,
+    params: dict,
+    strategy_returns: dict[str, pd.Series],
+    index_close: pd.Series,
+) -> dict:
+    """指数页的组合净值与指数净值。
+
+    组合是各股策略日收益的等权平均（每日再平衡），指数那条就是指数买入持有。
+    资金比、贝塔和区间统计复用 index_enhance 的 _pair_stats，口径与指数增强一致。
+    """
+    from algorithms.index_enhance import _equity, _pair_stats, _stock_returns, _trailing
+
+    calendar = index_close.index
+    matrix = pd.DataFrame({symbol: values for symbol, values in strategy_returns.items()}).reindex(calendar)
+    portfolio = matrix.mean(axis=1).fillna(0.0)
+    benchmark = _stock_returns(index_close)
+
+    strategy_equity = _equity(portfolio)
+    benchmark_equity = _equity(benchmark)
+    stats = _pair_stats(portfolio, benchmark)
+    stats_10y = _pair_stats(*_trailing(portfolio, benchmark, 10))
+    since_2021 = portfolio.index >= pd.Timestamp("2021-01-01")
+    stats_since_2021 = _pair_stats(portfolio.loc[since_2021], benchmark.loc[since_2021])
+    years = {}
+    for year in sorted({int(value) for value in calendar.year}):
+        mask = portfolio.index.year == year
+        if mask.sum() < 2:
+            continue
+        years[str(year)] = _pair_stats(portfolio.loc[mask], benchmark.loc[mask])
+
+    return {
+        "id": algorithm["id"],
+        "name": algorithm["name"],
+        "note": algorithm["note"],
+        "params": dict(params),
+        "equity": series(strategy_equity),
+        "benchmark_equity": series(benchmark_equity),
+        "stats": stats,
+        "stats_10y": stats_10y,
+        "stats_since_2021": stats_since_2021,
+        "years": years,
+    }
+
+
+def merge_index_symbol(path: Path, entry: dict) -> dict:
+    """把指数页的算法条目合并进 NDX.json，保留行情数组和别人的算法。"""
+    if path.exists():
+        record = json.loads(path.read_text(encoding="utf-8"))
+    else:
+        raise FileNotFoundError(f"指数 JSON 不存在：{path}（先跑指数增强或 F-Score）")
+    merged = {**record, "algorithms": {entry["id"]: entry}}
+    write_merged(path, merged)
+    return merged
+
+
+def _align_to_existing(frame: pd.DataFrame, path: Path) -> pd.DataFrame:
+    """已有 JSON 时，把行情对齐到它记录的 dates。
+
+    数据集的 JSON 可能按共同交易日写成（例如 us-agri 只有 1240 天，行情有 1255 天），
+    直接合并会让数组长度对不上。以已提交的 dates 为准，多出来的交易日不写。
+    """
+    if not path.exists():
+        return frame
+    record = json.loads(path.read_text(encoding="utf-8"))
+    dates = pd.to_datetime(record.get("dates") or [])
+    if dates.empty:
+        return frame
+    aligned = frame.loc[frame["date"].isin(set(dates))].reset_index(drop=True)
+    missing = set(dates) - set(aligned["date"])
+    if missing:
+        raise ValueError(f"{path.name}: JSON 里有 {len(missing)} 个日期在行情中找不到")
+    return aligned
+
